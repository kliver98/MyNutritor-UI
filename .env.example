# ==============================================================================
# MyNutritor UI - Variables de Entorno
# Copia este archivo a `.env` para desarrollo local o configúralas en GitHub
# (Settings -> Secrets and variables -> Actions -> Variables / Secrets)
# ==============================================================================

# URL base del Backend (Cloud Run o servidor local)
# En GitHub: Configurar en vars.VITE_API_BASE_URL o secrets.VITE_API_BASE_URL
VITE_API_BASE_URL=https://my-backend-url.com

# Ruta base de GitHub Pages (ej. '/MyNutritor-UI' o '' para dominios raíz)
# En GitHub: Configurar en vars.BASE_PATH
BASE_PATH=/base-url-path

# Entorno de la aplicación ('production', 'staging', 'development')
VITE_APP_ENV=development

# Timeout de peticiones HTTP en milisegundos (por defecto: 15000)
VITE_API_TIMEOUT_MS=15000

# Habilitar botones de acceso rápido de prueba / demo (true/false)
VITE_ENABLE_DEMO_SHORTCUTS=true
